# Copy this file to backend/.env and fill in your own values.
# The real .env is gitignored. Never commit secrets.

# Investec programmable banking sandbox credentials.
# Grab these from the Investec developer portal once you have a sandbox
# profile. The backend uses them to fetch your account transactions.
INVESTEC_CLIENT_ID=your-investec-client-id
INVESTEC_SECRET=your-investec-secret
INVESTEC_API_KEY=your-investec-api-key

# Shared secret between the card code and this backend. The card sends it
# as the x-api-key header on every /check and /record call. Make it long
# and random. The same value goes into the card IDE as GIGGUARD_API_KEY.
GIGGUARD_API_KEY=change-me-to-a-long-random-string

# Port the backend listens on.
PORT=3000
